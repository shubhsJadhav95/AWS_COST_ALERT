pipeline {
    agent any

    parameters {
        string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS Region')
<<<<<<< HEAD
        string(name: 'AWS_ACCOUNT_ID', defaultValue: '431618680847', description: 'AWS Account ID')
=======
        string(name: 'AWS_ACCOUNT_ID', defaultValue: '347026173735', description: 'AWS Account ID')
>>>>>>> 49683a48882ed388784dd19ab59a0654f0a7dd70
        string(name: 'ECR_REPO_NAME', defaultValue: 'costspike-backend', description: 'ECR Repository Name')
        string(name: 'VERSION', defaultValue: 'latest', description: 'Docker Image Version')
        string(name: 'CLUSTER_NAME', defaultValue: 'costspike-cluster', description: 'EKS Cluster Name')
    }

    tools {
        jdk 'jdk'
        maven 'maven3'
    }

    environment {
        BACKEND_DIR = 'backend/aws-alert'
        IMAGE_URI = "${params.AWS_ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com/${params.ECR_REPO_NAME}"
        KUBECONFIG = "/var/lib/jenkins/.kube/config"
    }

    stages {

        stage('Checkout Source Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/shubhsJadhav95/AWS_COST_ALERT.git'
            }
        }

        stage('Build Application') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

      stage("Test Application") {
            steps {
                dir("${BACKEND_DIR}") {
                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY', variable: 'AWS_ACCESS_KEY'),
                        string(credentialsId: 'AWS_SECRET_KEY', variable: 'AWS_SECRET_KEY')
                    ]) {
                        sh '''
                            export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY
                            export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_KEY
        
                            mvn test
                        '''
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${BACKEND_DIR}") {
                    withSonarQubeEnv('sonar-server') {
                        sh """
                            mvn sonar:sonar \
                              -Dsonar.projectKey=costspike-backend \
                              -Dsonar.java.binaries=target/classes
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dir("${BACKEND_DIR}") {
                    dependencyCheck(
                        additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit',
                        odcInstallation: 'DP-Check'
                    )

                    dependencyCheckPublisher(pattern: '**/dependency-check-report.xml')
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh 'trivy fs --format table -o trivy-report.txt .'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh 'docker build -t ${ECR_REPO_NAME}:${BUILD_NUMBER} .'
                }
            }
        }

        stage('AWS ECR Login & Setup') {
            steps {
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY', variable: 'AWS_ACCESS_KEY'),
                    string(credentialsId: 'AWS_SECRET_KEY', variable: 'AWS_SECRET_KEY')
                ]) {
                    sh '''
                        set -e

                        export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY
                        export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_KEY
                        export AWS_DEFAULT_REGION=${AWS_REGION}

                        aws sts get-caller-identity

                        aws ecr describe-repositories \
                          --repository-names ${ECR_REPO_NAME} \
                          --region ${AWS_REGION} || \
                        aws ecr create-repository \
                          --repository-name ${ECR_REPO_NAME} \
                          --region ${AWS_REGION}

                        aws ecr get-login-password --region ${AWS_REGION} | \
                        docker login --username AWS --password-stdin \
                        ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                    '''
                }
            }
        }

        stage('Tag & Push Image') {
            steps {
                sh """
                    docker tag ${ECR_REPO_NAME}:${BUILD_NUMBER} ${IMAGE_URI}:${BUILD_NUMBER}
                    docker tag ${ECR_REPO_NAME}:${BUILD_NUMBER} ${IMAGE_URI}:latest

                    docker push ${IMAGE_URI}:${BUILD_NUMBER}
                    docker push ${IMAGE_URI}:latest
                """
            }
        }

        stage('Configure EKS Access') {
            steps {
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY', variable: 'AWS_ACCESS_KEY'),
                    string(credentialsId: 'AWS_SECRET_KEY', variable: 'AWS_SECRET_KEY')
                ]) {
                    sh '''
                        set -e

                        export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY
                        export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_KEY
                        export AWS_DEFAULT_REGION=${AWS_REGION}

                        aws eks update-kubeconfig \
                          --region ${AWS_REGION} \
                          --name ${CLUSTER_NAME}
                    '''
                }
            }
        }

                  stage('Deploy to EKS') {
            steps {
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY', variable: 'AWS_ACCESS_KEY'),
                    string(credentialsId: 'AWS_SECRET_KEY', variable: 'AWS_SECRET_KEY')
                ]) {
                    sh '''
                        set -e
        
                        export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY
                        export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_KEY
                        export AWS_DEFAULT_REGION=${AWS_REGION}
        
                        export KUBECONFIG=/var/lib/jenkins/.kube/config
                        
                        kubectl apply -f k8s/backend/secret.yml
                        kubectl apply -f k8s/backend/deployment.yml
                        kubectl apply -f k8s/backend/service.yml
                    '''
                }
            }
        }
        
            stage('Verify Deployment') {
                steps {
                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY', variable: 'AWS_ACCESS_KEY'),
                        string(credentialsId: 'AWS_SECRET_KEY', variable: 'AWS_SECRET_KEY')
                    ]) {
                        sh '''
                            export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY
                            export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_KEY
                            export AWS_DEFAULT_REGION=${AWS_REGION}
            
                            export KUBECONFIG=/var/lib/jenkins/.kube/config
            
                            kubectl get pods -A
                            kubectl get svc -A
                        '''
                    }
                }
            }
            stage('Cleanup Docker Images') {
            steps {
                sh '''
                    docker rmi ${IMAGE_URI}:${BUILD_NUMBER} || true
                    docker rmi ${IMAGE_URI}:latest || true
                    docker image prune -f
                '''
            }
        }
        }
        
        post {
        
            success {
                echo 'Pipeline completed successfully'
            }
        
            failure {
                echo 'Pipeline failed'
            }
        
            always {
                archiveArtifacts artifacts: '**/trivy-report.txt', allowEmptyArchive: true
            }
        }
        
        
        }